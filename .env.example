# Copy to .env. Every value has a working local default, so this file is optional for `docker compose up`.

POSTGRES_USER=realstate
POSTGRES_PASSWORD=realstate
POSTGRES_DB=realstate

# Used by `pnpm dev:api` and `pnpm db:migrate` outside Docker.
DATABASE_URL=postgres://realstate:realstate@localhost:5432/realstate

# Used by `pnpm dev:web`.
API_INTERNAL_URL=http://localhost:4000
SITE_URL=http://localhost:3000

# Optional override for the site's GA4 measurement ID. Set to empty to disable; rebuild after changes.
# Disabled in development, Vercel preview deployments, and Sanity Draft Mode.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-754VY12EFX

# Property contact-form email. Vercel's Resend integration sets RESEND_API_KEY.
# Verify the sending domain in Resend before setting LEAD_EMAIL_FROM.
# RESEND_API_KEY=
# LEAD_EMAIL_FROM=Alex Nolasco Imóveis <contato@alexnolasco.com.br>
# LEAD_EMAIL_TO=alexnolascoimoveis@hotmail.com

# Create the project at https://www.sanity.io/manage. The Studio cannot load content until this is a real project ID.
SANITY_STUDIO_PROJECT_ID=palceholder
# Dataset for Sanity CLI commands. The Studio itself has a workspace per dataset (/production and /development).
SANITY_STUDIO_DATASET=production
# Sites the Studio's "Pré-visualização" tool opens: production previews the deployed site, development the local one.
# SANITY_STUDIO_PRODUCTION_URL=https://real-state-one-smoky.vercel.app
# SANITY_STUDIO_DEVELOPMENT_URL=http://localhost:3000

# The web app's Sanity project and dataset (the same project as the Studio).
SANITY_PROJECT_ID=
SANITY_DATASET=development
# Editor token: the website saves "Cadastre seu Imóvel" submissions with it, and the listing
# importer (pnpm --filter studio import) writes with it. Server-side only; never commit it.
# SANITY_API_WRITE_TOKEN=
# Viewer token: preview mode reads drafts with it, and it is sent to the browser while preview mode is
# on so drafts update live. Without it the site works, but the Studio preview shows published content only.
# SANITY_API_READ_TOKEN=
# Redis REST store (Upstash) for page visits, used to rank the home page list. Vercel's integration sets these.
# Without them nothing is recorded and the list shows the newest listings.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Where click-to-edit links in preview mode point. Use http://localhost:3333 when running the Studio locally.
# SANITY_STUDIO_URL=https://alexnolasco.sanity.studio
