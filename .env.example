# Copy to .env. Every value has a working local default, so this file is optional for `docker compose up`.

POSTGRES_USER=realstate
POSTGRES_PASSWORD=realstate
POSTGRES_DB=realstate

# Used by `pnpm dev:api` and `pnpm db:migrate` outside Docker.
DATABASE_URL=postgres://realstate:realstate@localhost:5432/realstate

# Used by `pnpm dev:web`.
API_INTERNAL_URL=http://localhost:4000
SITE_URL=http://localhost:3000

# Create the project at https://www.sanity.io/manage. The Studio cannot load content until this is a real project ID.
SANITY_STUDIO_PROJECT_ID=palceholder
SANITY_STUDIO_DATASET=production
